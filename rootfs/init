#!/bin/sh

DATE=$(date +%Y.%m.%d\ %H:%M:%S)

crlog () {
  echo $1 >> /proc/1/fd/1
}

crlog "[${DATE}] Starting container: TorrentMonitor ${TM_VERSION}"

# Configure system
# Set PHP timezone
sed -i "/date\\.timezone/d" /etc/php85/php.ini
echo "date.timezone = ${PHP_TIMEZONE}" >> /etc/php85/php.ini
sed -i "/date\\.timezone/d" /etc/php85/cli/php.ini
echo "date.timezone = ${PHP_TIMEZONE}" >> /etc/php85/cli/php.ini

# Set PHP memory limit
sed -i "/memory_limit/d" /etc/php85/php.ini
echo "memory_limit = ${PHP_MEMORY_LIMIT}" >> /etc/php85/php.ini
sed -i "/memory_limit/d" /etc/php85/cli/php.ini
echo "memory_limit = ${PHP_MEMORY_LIMIT}" >> /etc/php85/cli/php.ini
sed -i "/memory_limit/d" /etc/php85/php-fpm.conf
echo "php_admin_value[memory_limit] = ${PHP_MEMORY_LIMIT}" >> /etc/php85/php-fpm.conf

# Compatibility links (the converter below needs the php command)
test -f /usr/bin/php-fpm || ln -s /usr/sbin/php-fpm85 /usr/bin/php-fpm
test -f /usr/bin/php || ln -s /usr/bin/php85 /usr/bin/php

# Data of TorrentMonitor 3.x (SQLite database in the db volume) is converted once to the JSON
# files of version 4. The database file is left in place and is not used afterwards.
DATA_DIR=/data/htdocs/db
if [ ! -f "${DATA_DIR}/config.json" ] && [ -s "${DATA_DIR}/tm.sqlite" ]; then
  crlog "[${DATE}] Converting the TorrentMonitor 3.x database to the new data format..."
  set -- --type=sqlite "--db=${DATA_DIR}/tm.sqlite" "--data=${DATA_DIR}"
  if [ -n "$ENCRYPTION_KEY" ]; then
    set -- "$@" "--key=${ENCRYPTION_KEY}"
  elif [ -f "${DATA_DIR}/db_crypt.key" ]; then
    set -- "$@" "--key-file=${DATA_DIR}/db_crypt.key"
  fi
  [ -f "${DATA_DIR}/config.xml" ] && set -- "$@" "--config-xml=${DATA_DIR}/config.xml"
  if php /data/htdocs/tools/convert-db.php "$@" >> /proc/1/fd/1 2>&1; then
    crlog "[${DATE}] Conversion finished."
  else
    crlog "[${DATE}] Conversion FAILED: TorrentMonitor will start as a new installation. The database file is untouched."
  fi
fi

# Set cron timeout for engine.php
echo "${CRON_TIMEOUT} ${CRON_COMMAND}" > /etc/crontabs/nginx

# Configure nginx port (validate to avoid corrupting nginx config)
case "$NGINX_PORT" in
  ''|*[!0-9]*)
    crlog "Invalid NGINX_PORT '${NGINX_PORT}': must be a numeric TCP port between 1 and 65535"
    exit 1
    ;;
esac
if [ "$NGINX_PORT" -lt 1 ] || [ "$NGINX_PORT" -gt 65535 ]; then
  crlog "Invalid NGINX_PORT '${NGINX_PORT}': must be a numeric TCP port between 1 and 65535"
  exit 1
fi
sed -i "s/listen[[:space:]]*[0-9][0-9]*;/listen ${NGINX_PORT};/" /etc/nginx/conf.d/default.conf

# Force user/group ID
[ "q${PUID}" == "q" ] || usermod -o -u "$PUID" nginx
[ "q${PGID}" == "q" ] || groupmod -o -g "$PGID" nginx

# Set owner for app directory
chown -R nginx:nginx /data/htdocs
chown -R nginx:nginx /var/log/nginx

# Write temp files by nginx
chmod 777 /tmp

# Check runs started from the web interface or the API run as the nginx user, and only root may
# write to the container's output. They write to this file instead (see log.output in config.php),
# and root passes it on, so that these runs show in "docker logs" like the scheduled ones.
RUN_OUTPUT=/var/log/torrentmonitor-run.log
: > "$RUN_OUTPUT"
chown nginx:nginx "$RUN_OUTPUT"
tail -F -n 0 "$RUN_OUTPUT" >> /proc/1/fd/1 2>/dev/null &

# Start apps
php-fpm
nginx -g 'daemon off;' &
crlog "Starting cron task..."
crond -f >> /proc/1/fd/1
